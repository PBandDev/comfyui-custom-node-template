{
  "name": "comfyui-custom-node",
  "version": "1.0.0",
  "description": "A ComfyUI custom node",
  "type": "module",
  "scripts": {
    "dev": "tsc --noEmit -p frontend/tsconfig.json && vite build --watch --config frontend/vite.config.ts",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "pnpm test:unit && pnpm test:e2e",
    "setup:e2e": "playwright install --with-deps chromium && node scripts/setup-e2e-comfy.mjs",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:backend": "uv run pytest tests/python tests/backend -q",
    "test:unit": "pnpm test:frontend && pnpm test:backend",
    "test:e2e": "pnpm build && pnpm setup:e2e && playwright test",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config frontend/vitest.config.ts"
  },
  "keywords": [
    "comfyui",
    "custom node",
    "extension"
  ],
  "author": "Your Name",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "^1.32.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "vitest": "^4.0.16"
  }
}
